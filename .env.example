# ==============================================================================
# YouTube Review Priority System (Frontend) - Environment Variables
# ==============================================================================
# Aplikasi ini dirancang dengan Dual-Mode API Adapter (ADR-0002).
# Secara default, aplikasi langsung berjalan dalam MOCK MODE (in-memory)
# dengan dataset realistis tanpa mewajibkan backend aktif atau file .env.
#
# Jika ingin menghubungkan ke REST API backend nyata:
# 1. Salin file ini:
#    cp .env.example .env
# 2. Atur PUBLIC_ENABLE_MOCK=false dan sesuaikan PUBLIC_API_BASE_URL.
# ==============================================================================

# URL endpoint REST API Backend
PUBLIC_API_BASE_URL=http://localhost:3000

# Mode default adapter API:
# - true  : Gunakan Mock In-Memory API (default)
# - false : Gunakan Live REST API Backend
PUBLIC_ENABLE_MOCK=true
